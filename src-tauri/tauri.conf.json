    "publisher": "UBND xã Núi Cấm",
    "copyright": "UBND xã Núi Cấm",
    "homepage": "https://dieuhanh.xanuicam.vn",
    "category": "Business",
    "shortDescription": "Hệ thống điều hành công việc UBND xã Núi Cấm",
    "longDescription": "Ứng dụng cài đặt của Hệ thống điều hành công việc UBND xã Núi Cấm. Toàn bộ dữ liệu và đăng nhập vẫn ở hệ thống web dieuhanh.xanuicam.vn.",
    "createUpdaterArtifacts": true,
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
