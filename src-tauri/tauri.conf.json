{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UBND Núi Cấm",
  "mainBinaryName": "ubnd-app",
  "version": "0.1.0",
  "identifier": "vn.xanuicam.dieuhanh",
  "build": {
    "frontendDist": "https://dieuhanh.xanuicam.vn"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'none'",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
